# Python 虛擬環境（勿提交；各機器自行 python -m venv .venv）
.venv/
venv/
env/
**/.venv/

# 快取與編譯產物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit 本機密鑰（若使用 secrets）
.streamlit/secrets.toml

# kwara 本機 SQLite 與快照產物（clone 後由程式自動建立）
kwara/data/*.db
kwara/data/*.db-*
kwara/data/snapshots/
kwara/data/exports/

# 本機匯入／暫存資料（範例請放在版本庫根目錄，例如 test_data_*.csv）
kwara/*.csv
*.xlsx

# whois_osint 執行輸出（可選）
whois_osint/whois_results*
whois_osint/whois_cache.csv

# Claude Code 本機設定
.claude/

# 常見系統檔
Thumbs.db
.DS_Store
