# Python 虛擬環境（勿提交；各機器自行 python -m venv .venv）
.venv/
venv/
env/
**/.venv/

# 快取與編譯產物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit 本機密鑰（若使用 secrets）
.streamlit/secrets.toml

# kwara 本機 SQLite 與快照產物（clone 後由程式自動建立）
kwara/data/*.db
kwara/data/*.db-*
kwara/data/snapshots/
kwara/data/exports/

# 本機匯入／暫存資料（範例請放在版本庫根目錄，例如 test_data_*.csv）
kwara/*.csv
*.xlsx

# whois_osint 執行輸出（可選）
whois_osint/whois_results*
whois_osint/whois_cache.csv

# Claude Code 本機設定
.claude/

# 對外送件提案資料（與 kwara codebase 不同生命週期；放外面、不入 repo）
FNF_OSINT_2026_*

# 常見系統檔
Thumbs.db
.DS_Store

# DB backup 檔案（kwara.db.before_merge_* 等）
kwara/data/*.db.*

# 個人執行腳本（ad-hoc，與 kwara 工具不同生命週期；放外面、不入 repo）
/_*.py
# 已執行完的一次性腳本歸檔（2026-06-10 從 root 移入；保持不入 repo）
/scripts/oneshot/

# 報告產出（與 kwara 工具不同生命週期；放外面、不入 repo）
/0510*.md
/0510*.pdf
/UNIFIED_CLUSTER_REPORT_*
/kwara_分析原理.md
/kwara_角色定位.md

# qsh_pdf：報告專用內容（圖表來源、quarto 來源、編譯產物、樣式）
# 注意：qsh_pdf/build-pdf.sh 與 qsh_pdf/pdf-style.css 是工具，不在此 ignore 範圍
qsh_pdf/charts/*.mmd
qsh_pdf/charts/*.png
qsh_pdf/charts/*.svg
qsh_pdf/charts/captions.txt
qsh_pdf/qsh_report.qd
qsh_pdf/smoke.qd
qsh_pdf/report.css
qsh_pdf/out/
qsh_pdf/out_html/

# FB 採集示範資料（demo/ 內檔案逐機更新，不入 repo）
demo/

# 案件報告產物（含偵查資料，勿提交至公開 repo）
reports/

# 案件專屬 / 一次性文件（內部，不入公開 repo）
/QSH_E2E_TEST_REPORT_2026-04-28.md
/PRESENTATION_SOURCE.md
/shortlink_abuse_evidence_kit_mvp_8290f6f4.plan.md
/backfill_tracking_ids.py
