# Python 虛擬環境（勿提交；各機器自行 python -m venv .venv）
.venv/
venv/
env/
**/.venv/

# 快取與編譯產物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit 本機密鑰（若使用 secrets）
.streamlit/secrets.toml

# kwara 本機 SQLite 與快照產物（clone 後由程式自動建立）
kwara/data/*.db
kwara/data/*.db-*
kwara/data/snapshots/
kwara/data/exports/

# 本機匯入／暫存資料（範例請放在版本庫根目錄，例如 test_data_*.csv）
kwara/*.csv
*.xlsx

# whois_osint 執行輸出（可選）
whois_osint/whois_results*
whois_osint/whois_cache.csv

# Claude Code 本機設定（settings.json 是共用的權限設定，刻意納管）
.claude/
!.claude/settings.json

# 對外送件提案資料（與 kwara codebase 不同生命週期；放外面、不入 repo）
FNF_OSINT_2026_*

# 常見系統檔
Thumbs.db
.DS_Store

# DB backup 檔案（kwara.db.before_merge_* 等）
kwara/data/*.db.*

# 個人執行腳本（ad-hoc，與 kwara 工具不同生命週期；放外面、不入 repo）
/_*.py

# 案件產物（報告、排版工具鏈、採集素材）與 kwara 工具不同生命週期。
# 2026-08-05 已全數移出至 repo 外的案件工作區；以下為防止再度累積的守門條款。
/0510*.md
/0510*.pdf
/UNIFIED_CLUSTER_REPORT_*
/qsh_pdf/
/demo/

# 案件報告產物（含偵查資料，勿提交至公開 repo）
reports/
# 判別器實驗資料（discovery.py 的實測產出）。含 5,232 個第三方網站的
# ads.txt 內容與廣告帳號 —— 那是別人的資料，不放進公開 repo。
# FINDINGS.md 是研究紀錄，data/ 的參照母體無法從 repo 或 DB 重建，
# 兩者都只存在本機，勿刪。
/discovery/
# ...except the integrity manifest. The hashes belong in git precisely because
# the data does not: a commit is a timestamp nobody can quietly move, so a
# reviewer can establish that a corpus file is what it was on that date without
# the repo ever carrying the third-party data. See corpus_manifest.py.
!/discovery/
/discovery/*
!/discovery/CORPUS-MANIFEST.json


# 案件專屬 / 一次性文件（內部，不入公開 repo）
/QSH_E2E_TEST_REPORT_2026-04-28.md
/PRESENTATION_SOURCE.md
/shortlink_abuse_evidence_kit_mvp_8290f6f4.plan.md
/backfill_tracking_ids.py

# 可編輯安裝的產物
*.egg-info/
/build/
/dist/

# coverage data (parallel mode writes .coverage.<host>.<pid>.<rand>)
.coverage
.coverage.*
htmlcov/
